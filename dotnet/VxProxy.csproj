<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VxProxy</RootNamespace>
    <AssemblyName>vx-connector</AssemblyName>
    <!--
      Unconditional on purpose. The old form was Condition="Exists('vx-proxy.ico')"
      against a file that was never in the repo, so the exe silently shipped the stock
      .NET icon for every release. A missing icon should break the build instead.
      Regenerate with tools/generate-icon.ps1.
    -->
    <ApplicationIcon>vx-connector.ico</ApplicationIcon>
    <Product>VX Connector</Product>
    <AssemblyTitle>VX Connector</AssemblyTitle>
    <Version>1.5.2</Version>
    <FileVersion>1.5.2</FileVersion>
    <InformationalVersion>1.5.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright © 2026</Copyright>
    <Company></Company>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Roughly halves the exe (~154 MB to ~78 MB). Worth the small decompression cost at
      process start because it halves both the first download and every auto-update
      download the app pulls from GitHub. Note the GSPconnect stub is a second launch of
      this same binary, so the cost is paid twice per session.

      PublishTrimmed is deliberately absent: trimming is unsupported for WinForms.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Also embedded as a managed resource so MainForm can show the same icon in its
      title bar and alt-tab entry. ApplicationIcon alone only reaches the shell: it
      becomes a Win32 resource on the exe, which a single-file app can't reopen from
      disk, and ExtractAssociatedIcon would hand back one size instead of the set.
      LogicalName pins the lookup key so a namespace change can't break it.
    -->
    <EmbeddedResource Include="vx-connector.ico" LogicalName="vx-connector.ico" />
  </ItemGroup>
</Project>
